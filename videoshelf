<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VideoShelf · YouTube 知识库</title>

  <style>
    :root {
      --bg: #0f1117;
      --panel: #171a23;
      --panel-2: #202431;
      --text: #f4f6fb;
      --muted: #9ca3b5;
      --line: #2b3040;
      --pink: #fb7299;
      --gold: #ffd166;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont,
        "Microsoft YaHei", sans-serif;
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
      border: 0;
    }

    .topbar {
      height: 64px;
      display: flex;
      align-items: center;
      gap: 22px;
      padding: 0 24px;
      background: #151821;
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 0;
      z-index: 5;
    }

    .logo {
      color: var(--pink);
      font-size: 21px;
      font-weight: 800;
      white-space: nowrap;
    }

    .logo span {
      color: white;
    }

    .search {
      display: flex;
      flex: 1;
      max-width: 680px;
      margin: auto;
    }

    .search input {
      flex: 1;
      padding: 12px 15px;
      color: white;
      background: #242938;
      border: 1px solid #303649;
      border-radius: 8px 0 0 8px;
      outline: none;
    }

    .search button {
      width: 54px;
      color: white;
      background: var(--pink);
      border-radius: 0 8px 8px 0;
      font-size: 18px;
    }

    .user {
      color: var(--muted);
      white-space: nowrap;
    }

    .layout {
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr);
      min-height: calc(100vh - 64px);
    }

    aside {
      padding: 22px 14px;
      background: #12151d;
      border-right: 1px solid var(--line);
    }

    .nav-title {
      margin: 18px 12px 8px;
      color: var(--muted);
      font-size: 12px;
    }

    .nav button {
      display: block;
      width: 100%;
      margin: 3px 0;
      padding: 12px;
      color: #c9cedb;
      text-align: left;
      background: transparent;
      border-radius: 8px;
    }

    .nav button:hover,
    .nav button.active {
      color: white;
      background: #292333;
    }

    .main {
      width: 100%;
      max-width: 1450px;
      margin: auto;
      padding: 28px;
    }

    .hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 24px;
    }

    .hero h1 {
      margin: 0 0 7px;
      font-size: 28px;
    }

    .hero p {
      margin: 0;
      color: var(--muted);
    }

    .primary {
      padding: 11px 17px;
      color: white;
      font-weight: 700;
      background: var(--pink);
      border-radius: 8px;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 24px;
    }

    .chip {
      padding: 8px 14px;
      color: #cbd0dd;
      background: var(--panel-2);
      border-radius: 20px;
    }

    .chip.active {
      color: white;
      background: var(--pink);
    }

    .content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 310px;
      gap: 22px;
    }

    .player-card,
    .panel {
      overflow: hidden;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 12px;
    }

    .player {
      aspect-ratio: 16 / 9;
      background: #08090d;
    }

    .player iframe {
      width: 100%;
      height: 100%;
      border: 0;
    }

    .meta {
      padding: 18px 20px;
    }

    .meta h2 {
      margin: 0 0 9px;
      font-size: 20px;
    }

    .source {
      color: var(--muted);
      font-size: 13px;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 16px;
    }

    .action {
      padding: 9px 12px;
      color: #dbe0eb;
      background: var(--panel-2);
      border-radius: 7px;
    }

    .action:hover {
      background: #303747;
    }

    .side {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .panel {
      padding: 18px;
    }

    .panel h3 {
      margin: 0 0 14px;
      font-size: 16px;
    }

    .note textarea {
      width: 100%;
      height: 140px;
      padding: 11px;
      color: white;
      background: #11141c;
      border: 1px solid var(--line);
      border-radius: 8px;
      outline: none;
      resize: vertical;
    }

    .save {
      margin-top: 10px;
      padding: 9px 13px;
      color: #241d00;
      font-weight: 700;
      background: var(--gold);
      border-radius: 7px;
    }

    .list {
      display: grid;
      gap: 11px;
    }

    .item {
      display: flex;
      gap: 10px;
      padding: 9px;
      border-radius: 8px;
      cursor: pointer;
    }

    .item:hover {
      background: var(--panel-2);
    }

    .thumb {
      display: grid;
      width: 90px;
      height: 52px;
      place-items: center;
      color: #cbd0dd;
      background: #343a4c;
      border-radius: 5px;
      font-size: 20px;
    }

    .item b {
      font-size: 13px;
      line-height: 1.35;
    }

    .item small {
      display: block;
      margin-top: 4px;
      color: var(--muted);
    }

    .toast {
      display: none;
      position: fixed;
      right: 24px;
      bottom: 24px;
      padding: 12px 16px;
      background: #292f3d;
      border-radius: 8px;
      box-shadow: 0 8px 30px #0008;
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 10;
      place-items: center;
      padding: 20px;
      background: #0009;
    }

    .dialog {
      width: min(580px, 100%);
      padding: 22px;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 12px;
    }

    .dialog h2 {
      margin-top: 0;
    }

    .dialog p {
      color: var(--muted);
    }

    .dialog input {
      width: 100%;
      padding: 12px;
      color: white;
      background: #11141c;
      border: 1px solid var(--line);
      border-radius: 7px;
      outline: none;
    }

    .dialog-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 16px;
    }

    .secondary {
      padding: 10px 15px;
      color: white;
      background: var(--panel-2);
      border-radius: 7px;
    }

    @media (max-width: 850px) {
      .layout {
        grid-template-columns: 1fr;
      }

      aside {
        display: none;
      }

      .main {
        padding: 18px;
      }

      .content {
        grid-template-columns: 1fr;
      }

      .topbar {
        gap: 10px;
        padding: 0 12px;
      }

      .user {
        display: none;
      }

      .hero {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="logo">Video<span>Shelf</span></div>

    <div class="search">
      <input
        id="urlInput"
        placeholder="粘贴 YouTube 链接，例如 youtube.com/watch?v=..."
      />
      <button id="loadBtn">⌕</button>
    </div>

    <div class="user">访客模式</div>
  </header>

  <div class="layout">
    <aside>
      <div class="nav">
        <button class="active">⌂　首页</button>
        <button>▣　我的收藏</button>
        <button>◷　稍后观看</button>
        <button>▤　我的笔记</button>

        <div class="nav-title">我的分类</div>

        <button>📈　财经投资</button>
        <button>💻　科技</button>
        <button>🎓　学习</button>
      </div>
    </aside>

    <main class="main">
      <div class="hero">
        <div>
          <h1>你的 YouTube 知识库</h1>
          <p>用熟悉的内容，配合更清晰的整理、标签与笔记。</p>
        </div>

        <button class="primary" id="addBtn">
          ＋ 添加视频链接
        </button>
      </div>

      <div class="chips">
        <button class="chip active">全部</button>
        <button class="chip">财经投资</button>
        <button class="chip">科技</button>
        <button class="chip">学习</button>
        <button class="chip">未分类</button>
      </div>

      <section class="content">
        <div class="player-card">
          <div class="player">
            <iframe
              id="player"
              src="https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?rel=0&playsinline=1"
              title="YouTube video player"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen>
            </iframe>
          </div>

          <div class="meta">
            <h2 id="videoTitle">欢迎使用 VideoShelf</h2>

            <div class="source">
              来源：YouTube · Privacy-Enhanced Mode · 不额外投放平台广告
            </div>

            <div class="actions">
              <button class="action" id="favBtn">☆ 收藏</button>
              <button class="action" id="laterBtn">◷ 稍后观看</button>
              <button class="action" id="copyBtn">复制视频链接</button>
              <button class="action" id="openBtn">在 YouTube 打开</button>
            </div>
          </div>
        </div>

        <div class="side">
          <div class="panel note">
            <h3>📝 我的笔记</h3>

            <textarea
              id="note"
              placeholder="记录重点、时间戳、投资想法……">
            </textarea>

            <button class="save" id="saveNote">
              保存笔记
            </button>
          </div>

          <div class="panel">
            <h3>最近添加</h3>
            <div id="recent" class="list"></div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <div class="modal" id="modal">
    <div class="dialog">
      <h2>添加 YouTube 视频</h2>

      <p>
        只需粘贴视频链接。这个原型不使用 YouTube Data API。
      </p>

      <input
        id="modalUrl"
        placeholder="https://www.youtube.com/watch?v=..."
      />

      <div class="dialog-actions">
        <button class="secondary" id="cancel">取消</button>
        <button class="primary" id="confirm">载入视频</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    const $ = (selector) => document.querySelector(selector);

    let currentId = "dQw4w9WgXcQ";

    let records = JSON.parse(
      localStorage.getItem("videoshelf-records") || "[]"
    );

    function getVideoId(rawUrl) {
      try {
        const url = new URL(rawUrl);

        if (url.hostname.includes("youtu.be")) {
          return url.pathname.slice(1).split("/")[0];
        }

        if (url.searchParams.get("v")) {
          return url.searchParams.get("v");
        }

        const match = url.pathname.match(
          //shorts/([^/]+)|/embed/([^/]+)/
        );

        return match ? match[1] || match[2] : null;
      } catch {
        return null;
      }
    }

    function showToast(message) {
      const toast = $("#toast");

      toast.textContent = message;
      toast.style.display = "block";

      setTimeout(() => {
        toast.style.display = "none";
      }, 2200);
    }

    function loadVideo(rawUrl) {
      const videoId = getVideoId(rawUrl);

      if (!videoId) {
        showToast("请输入有效的 YouTube 链接");
        return;
      }

      currentId = videoId;

      $("#player").src =
        `https://www.youtube-nocookie.com/embed/${videoId}?rel=0&playsinline=1`;

      $("#videoTitle").textContent =
        `YouTube 视频 · ${videoId}`;

      const existing = records.find(
        (item) => item.id === videoId
      );

      $("#note").value = existing ? existing.note : "";

      if (!existing) {
        records.unshift({
          id: videoId,
          note: "",
          date: new Date().toLocaleDateString("zh-CN")
        });

        records = records.slice(0, 8);

        localStorage.setItem(
          "videoshelf-records",
          JSON.stringify(records)
        );
      }

      renderRecentVideos();

      $("#modal").style.display = "none";
      showToast("视频已载入");
    }

    function renderRecentVideos() {
      const container = $("#recent");

      if (!records.length) {
        container.innerHTML =
          '<div style="color:var(--muted)">暂无记录</div>';
        return;
      }

      container.innerHTML = records
        .map(
          (item) => `
            <div class="item" data-id="${item.id}">
              <div class="thumb">▶</div>
              <div>
                <b>YouTube 视频</b>
                <small>${item.id} · ${item.date}</small>
              </div>
            </div>
          `
        )
        .join("");

      container.querySelectorAll(".item").forEach((item) => {
        item.onclick = () => {
          loadVideo(`https://youtu.be/${item.dataset.id}`);
        };
      });
    }

    $("#loadBtn").onclick = () => {
      loadVideo($("#urlInput").value);
    };

    $("#urlInput").onkeydown = (event) => {
      if (event.key === "Enter") {
        loadVideo(event.target.value);
      }
    };

    $("#addBtn").onclick = () => {
      $("#modal").style.display = "grid";
      $("#modalUrl").focus();
    };

    $("#cancel").onclick = () => {
      $("#modal").style.display = "none";
    };

    $("#confirm").onclick = () => {
      loadVideo($("#modalUrl").value);
    };

    $("#favBtn").onclick = () => {
      showToast("已加入收藏");
    };

    $("#laterBtn").onclick = () => {
      showToast("已加入稍后观看");
    };

    $("#copyBtn").onclick = () => {
      const link = `https://youtu.be/${currentId}`;

      navigator.clipboard
        ?.writeText(link)
        .then(() => showToast("链接已复制"));
    };

    $("#openBtn").onclick = () => {
      window.open(
        `https://www.youtube.com/watch?v=${currentId}`,
        "_blank"
      );
    };

    $("#saveNote").onclick = () => {
      const video = records.find(
        (item) => item.id === currentId
      );

      if (!video) {
        return;
      }

      video.note = $("#note").value;

      localStorage.setItem(
        "videoshelf-records",
        JSON.stringify(records)
      );

      showToast("笔记已保存");
    };

    renderRecentVideos();
  </script>
</body>
</html>
